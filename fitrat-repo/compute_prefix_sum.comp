#version 450 core
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
    uint spike_counts[];
} input_buffer;

layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer {
    uint prefix_sums[];
} output_buffer;

layout(set = 0, binding = 2, std430) buffer BlockSumsBuffer {
    uint block_sums[];
} block_sums_buffer;

shared uint shared_data[256];

void main() {
    uint global_id = gl_GlobalInvocationID.x;
    uint local_id = gl_LocalInvocationID.x;
    uint subgroup_id = local_id / gl_SubgroupSize;
    uint subgroup_local_id = gl_SubgroupInvocationID;
    
    // Load data
    uint value = input_buffer.spike_counts[global_id];
    
    // Step 1: Subgroup-level exclusive scan
    uint subgroup_exclusive = subgroupExclusiveAdd(value);
    uint subgroup_inclusive = subgroupInclusiveAdd(value);
    uint subgroup_total = subgroupBroadcast(subgroup_inclusive, gl_SubgroupSize - 1);
    
    // Step 2: Store subgroup totals to shared memory for inter-subgroup scan
    if (subgroup_local_id == gl_SubgroupSize - 1) {
        shared_data[subgroup_id] = subgroup_total;
    }
    barrier();
    
    // Step 3: Scan the subgroup totals (using first 8 threads for 8 subgroups)
    uint block_offset = 0;
    if (local_id < 8) {
        uint sum = shared_data[local_id];
        block_offset = subgroupExclusiveAdd(sum);
        shared_data[local_id] = block_offset;
    }
    barrier();
    
    // Step 4: Get the offset for this subgroup
    uint subgroup_offset = shared_data[subgroup_id];
    
    // Step 5: Final exclusive prefix sum
    uint exclusive_sum = subgroup_offset + subgroup_exclusive;
    output_buffer.prefix_sums[global_id] = exclusive_sum;
    
    // Step 6: Store block total for next level (if needed)
    if (local_id == 0) {
        uint total = shared_data[7] + subgroupBroadcast(subgroup_inclusive, gl_SubgroupSize - 1);
        block_sums_buffer.block_sums[gl_WorkGroupID.x] = total;
    }
}